{
  "name": "espace-membre",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "./node_modules/.bin/only-include-used-icons && next dev -p 8100",
    "build:next": "NODE_OPTIONS='--max-old-space-size=16384' next build",
    "build": "./node_modules/.bin/only-include-used-icons && npm run build:next",
    "start": "NODE_ENV=production next start",
    "lint": "eslint src",
    "migrate": "NODE_OPTIONS='--import tsx/esm' knex migrate:latest",
    "rolldown": "NODE_OPTIONS='--import tsx/esm' knex migrate:down",
    "e2e": "npx playwright test",
    "test": "NODE_ENV=test ts-mocha --paths -p tsconfig.json \"src/**/*.spec.ts\" \"__tests__/*.ts\" --exit --require ts-node/register --require ts-node/esm --icu-data-dir=./node_modules/full-icu --require ./__tests__/env-setup.ts --timeout 30000",
    "seed": "NODE_OPTIONS='--import tsx/esm' knex seed:run",
    "postinstall": "is-ci || husky install",
    "kysely-codegen": "./node_modules/.bin/kysely-codegen --include-pattern=\"(public|pgboss).*\" --out-file ./src/@types/db.d.ts",
    "staging-import-from-www": "tsx src/scripts/import-from-www",
    "dev-import-from-www": "ts-node src/scripts/import-from-www",
    "grist:setup-ops": "ts-node src/scripts/setup-grist-ops-table.ts",
    "grist:setup-segur": "ts-node src/scripts/setup-grist-segur-table.ts",
    "job:sync-dinum-emails": "tsx src/scripts/sync-dinum-emails",
    "job:sync-matrix-accounts": "tsx src/scripts/sync-matrix-accounts",
    "job:clean-teams-members": "tsx src/scripts/clean-teams-members",
    "job:recreate-email-if-user-active": "tsx src/scripts/recreate-email-if-user-active",
    "export-to-www": "./src/scripts/export-to-www.sh",
    "start-pgboss-jobs-dev": "ts-node src/server/schedulers/schedulePgBossJobs.ts",
    "start-jobs-dev": "npm run start-pgboss-jobs-dev",
    "start-jobs-prod": "tsx src/server/schedulers/schedulePgBossJobs.ts",
    "fixme": "node ./node_modules/.bin/fixme -p src",
    "pg-mermaid": "npx -s pg-mermaid --dbname secretariat --username secretariat -h 127.0.0.1 -p 5432 --password secretariat --excluded-tables badge_requests community knex_migrations knex_migrations_lock startup_aggregated_stats active_startups active_users users2"
  },
  "dependencies": {
    "@codegouvfr/react-dsfr": "^1.32.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.2",
    "@mui/base": "^5.0.0-beta.69",
    "@mui/material": "^5.15.10",
    "@sentry/nextjs": "10.69.0",
    "@sentry/node": "10.69.0",
    "@sindresorhus/slugify": "^1.1.0",
    "@socialgouv/matomo-next": "^1.9.1",
    "airtable": "^0.12.2",
    "aws-sdk": "^2.1664.0",
    "axios": "^1.8.4",
    "crisp-sdk-web": "^1.0.25",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "deep-object-diff": "^1.1.9",
    "ejs": "^3.1.9",
    "front-matter": "^4.0.2",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "juice": "^9.1.0",
    "knex": "^3.2.9",
    "kysely": "^0.28.16",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lodash": "^4.17.21",
    "markdown-it": "^14.1.1",
    "marked": "^9.1.0",
    "mjml": "^5.1.0",
    "next": "^15.5.23",
    "next-auth": "^4.24.11",
    "nodemailer": "^7.0.13",
    "nuqs": "^2.0.4",
    "p-all": "^3.0.0",
    "pg": "^8.11.5",
    "pg-boss": "^9.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-hook-form": "^7.73.1",
    "react-leaflet": "^4.2.1",
    "react-markdown-editor-lite": "^1.3.4",
    "react-select": "^5.8.1",
    "react-use": "^17.5.1",
    "sharp": "^0.35.3",
    "sib-api-v3-sdk": "^8.5.0",
    "ts-custom-error": "^3.3.1",
    "ts-pattern": "^5.5.0",
    "tss-react": "^4.9.4",
    "tsx": "^4.21.0",
    "turndown": "^7.2.0",
    "unzipper": "^0.12.3",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.48.0",
    "@types/chai": "^5.2.2",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22",
    "@types/pg": "^8.11.0",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@types/sinon": "^17.0.4",
    "chai": "^4.4.1",
    "chai-http": "^4.4.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^15.5.23",
    "eslint-config-prettier": "^10",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5",
    "fixme": "^0.7.0",
    "husky": "^9.1.6",
    "is-ci": "^4.1.0",
    "kysely-codegen": "^0.20.0",
    "nock": "^13.5.1",
    "node-talisman": "^1.29.11",
    "prettier": "^3",
    "proxyquire": "^2.1.3",
    "rewire": "^7.0.0",
    "sass": "^1.102.0",
    "sinon": "^17.0.1",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.3"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "sharp@0.35.3": true
  }
}
