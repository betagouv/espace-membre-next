    {
      "parameters": {
        "jsCode": "const anchor = $('Matomo: données').item.json;\nconst u = $input.first() ? $input.first().json : null;\nfunction pwd() {\n  const c = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%';\n  let s = ''; for (let i = 0; i < 20; i++) s += c[Math.floor(Math.random() * c.length)];\n  return s;\n}\nlet matomoLogin, createUser = false, tempPassword = null;\nif (u && u.login) {\n  matomoLogin = u.login;                       // existe -> réutilise\n} else if (u && u.result === 'error' && /inexistant|doesn't exist/i.test(u.message || '')) {\n  matomoLogin = anchor.Email; createUser = true; tempPassword = pwd();\n} else {\n  throw new Error('Matomo getUserByEmail inattendu: ' + JSON.stringify(u));\n}\nreturn [{ json: { ...anchor, matomoLogin, createUser, tempPassword } }];"
      },
