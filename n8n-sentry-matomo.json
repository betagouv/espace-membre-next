        "jsCode": "// Sentry n'a pas d'API de recherche : on filtre la liste (première page).\nconst anchor = $('Sentry: données').item.json;\nconst members = $input.all().map(i => i.json).filter(m => m && (m.email || m.id));\nconst found = members.find(m => (m.email || '').toLowerCase() === (anchor.Email || '').toLowerCase());\nreturn [{ json: { ...anchor, memberExists: !!found, memberId: found ? found.id : null } }];"
