      "parameters": {
        "jsCode": "// Pagination NON gérée ici (première page). Si ton org a >100 teams, ajoute une boucle.\nconst anchor = $('Sentry: données').item.json;\nconst teams = $input.all().map(i => i.json).filter(t => t && t.slug);\nconst found = teams.find(t => t.slug === anchor.Team_slug);\nreturn [{ json: { ...anchor, teamExists: !!found, teamId: found ? found.id : null } }];"
      },
      "type": "n8n-nodes-base.code",
